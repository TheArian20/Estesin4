rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function esAdministrador() {
      return request.auth != null
        && request.auth.uid == 'eeKKifjIAmXICHCQua6s2fmTVnl1';
    }

    // Contenido institucional que puede consultar cualquier visitante.
    match /recursos_personalizados/{documento} {
      allow read: if true;
      allow write: if esAdministrador();
    }

    match /eventos_calendario/{documento} {
      allow read: if true;
      allow write: if esAdministrador();
    }

    match /avisos/{documento} {
      allow read: if true;
      allow write: if esAdministrador();
    }

    match /mensajes_internos/{documento} {
      allow read: if true;
      allow write: if esAdministrador();
    }

    // Registro anonimo: los visitantes solo pueden crear eventos con los
    // campos previstos. Unicamente el administrador puede leerlos.
    match /visitas/{documento} {
      allow create: if request.resource.data.keys().hasOnly([
          'visitante_id', 'sesion_id', 'pagina', 'dispositivo', 'origen', 'creado_en'
        ])
        && request.resource.data.visitante_id is string
        && request.resource.data.visitante_id.size() <= 80
        && request.resource.data.sesion_id is string
        && request.resource.data.sesion_id.size() <= 80
        && request.resource.data.pagina is string
        && request.resource.data.pagina.size() <= 100
        && request.resource.data.dispositivo in ['movil', 'escritorio']
        && request.resource.data.origen is string
        && request.resource.data.origen.size() <= 120
        && request.resource.data.creado_en == request.time;
      allow read, update, delete: if esAdministrador();
    }

    // Todo lo demas contiene informacion administrativa o personal.
    match /{documento=**} {
      allow read, write: if esAdministrador();
    }
  }
}
